PORT=3001
NODE_ENV=development

# Optional. Production domains vantaro.io / www are already allowed in code.
# FRONTEND_URL=https://www.vantaro.io
FRONTEND_URL=http://localhost:5173

# Public API URL used for ProCredit hppRedirectUrl (and calendar links).
# In production set to your Render URL, e.g. https://vantaro.onrender.com
# API_PUBLIC_URL=https://vantaro.onrender.com
# PUBLIC_API_URL=https://vantaro.onrender.com

# Vantaro-Development — uncomment this block to use it
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vantaro-Production — uncomment this block to use it (comment out Development first)
# SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — EMAIL_FROM must use a verified domain in your Resend account
EMAIL_FROM=VANTARO <noreply@your-verified-domain.com>
EMAIL_FROM_LEADS=VANTARO Leads <lead@vantaro.io>
RESEND_API_KEY=
# Optional. Protects POST /api/jobs/follow-up-reminders if you trigger it from Render cron.
CRON_SECRET=

# Comma-separated emails that always get the admin role
ADMIN_EMAILS=you@your-domain.com

# ProCredit Bank e-Commerce (one-time Purchase + Hosted Payment Page)
# See server/docs/procredit-onboarding.md
PROCREDIT_API_BASE_URL=https://3dss2test.quipu.de:8000
PROCREDIT_MERCHANT_ID=
PROCREDIT_CERT_PATH=./certs/cert.pem
PROCREDIT_KEY_PATH=./certs/key.pem
PROCREDIT_CA_PATH=./certs/ca.pem
# Or paste PEM contents instead of files:
# PROCREDIT_CERT_PEM=
# PROCREDIT_KEY_PEM=
# PROCREDIT_CA_PEM=
PROCREDIT_CURRENCY=EUR
PROCREDIT_LANGUAGE=en
PROCREDIT_TEST_MODE=1

# TC-Dial Public API (leads via AgentSetDisposition webhook)
# Generate API key in TC-Dial Admin → API → Overview
TCDIAL_API_BASE_URL=https://your-tcdial-host.example
TCDIAL_API_KEY=
# Webhook signing public key from the TC-Dial API docs page (whpk_...)
TCDIAL_WEBHOOK_PUBLIC_KEY=whpk_
# Public URL of this server's webhook (used when calling POST /api/webhooks/tcdial/subscribe)
TCDIAL_WEBHOOK_URL=https://your-api-host.example/api/webhooks/tcdial/agent-set-disposition
# Optional filters (defaults: SALE only)
TCDIAL_CALL_STATUS_GROUPS=SALE
# TCDIAL_CALL_STATUS_IDS=473,123
# TCDIAL_CAMPAIGN_IDS=58,23
# Local testing only — never enable in production
# TCDIAL_WEBHOOK_SKIP_VERIFY=1

PORT=3001
NODE_ENV=development

# Optional. Production domains vantaro.io / www are already allowed in code.
# FRONTEND_URL=https://www.vantaro.io
FRONTEND_URL=http://localhost:5173

# Vantaro-Development — uncomment this block to use it
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vantaro-Production — uncomment this block to use it (comment out Development first)
# SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — EMAIL_FROM must use a verified domain in your Resend account
EMAIL_FROM=VANTARO <noreply@your-verified-domain.com>
RESEND_API_KEY=

# Comma-separated emails that always get the admin role
ADMIN_EMAILS=you@your-domain.com

# Same as entriks-hr: leave empty locally (Vite proxies /api).
# On Vercel you can set this, or omit it — production defaults to https://vantaro.onrender.com
# VITE_API_URL=https://vantaro.onrender.com
VITE_API_URL=

# Public Supabase keys for Google sign-in. Never put SERVICE_ROLE here.
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=
